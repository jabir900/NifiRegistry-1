            }
          },
          "runDurationMillis" : 0,
          "scheduledState" : "ENABLED",
          "schedulingPeriod" : "2 sec",
          "schedulingStrategy" : "TIMER_DRIVEN",
          "style" : { },
          "type" : "org.apache.nifi.processors.script.ExecuteScript",
          "yieldDuration" : "1 sec"
        }, {
          "autoTerminatedRelationships" : [ "failure" ],
          "bulletinLevel" : "WARN",
          "bundle" : {
            "artifact" : "nifi-scripting-nar",
            "group" : "org.apache.nifi",
            "version" : "2.9.0"
          },
          "comments" : "",
          "componentType" : "PROCESSOR",
          "concurrentlySchedulableTaskCount" : 1,
          "executionNode" : "ALL",
          "groupIdentifier" : "3c2703bb-d69d-3d84-bfa5-011a09caf010",
          "identifier" : "ccbb479e-da83-3d65-959f-706c761f4b7f",
          "name" : "GetEveryPageNYC311Pages",
          "penaltyDuration" : "30 sec",
          "position" : {
            "x" : 5541.88916015625,
            "y" : -1787.7777709960938
          },
          "properties" : {
            "Script Engine" : "Groovy",
            "Script Body" : "// Processor: Get Every NYC311 Page\n// Retrieves a fixed TOTAL_RECORDS from NYC 311,\n// using PAGE_SIZE records per API request.\n//\n// FIX: the two \"stop\" branches now transfer to REL_FAILURE instead of\n// REL_SUCCESS. Since \"success\" is wired to both SplitJson AND back into\n// this same processor (self-loop), routing the stop condition through\n// success caused it to re-forward the same last page forever in an\n// infinite no-op loop, flooding Elasticsearch with duplicates. Routing\n// to failure (already auto-terminated on this processor) correctly ends\n// the loop without re-sending anything.\n\nimport org.apache.commons.io.IOUtils\nimport java.nio.charset.StandardCharsets\nimport groovy.json.JsonSlurper\nimport org.apache.nifi.processor.io.StreamCallback\n\ndef flowFile = session.get()\nif (!flowFile) return\n\n// ===============================\n// CHANGE THESE VALUES\n// ===============================\n\ndef TOTAL_RECORDS = 1000\ndef PAGE_SIZE = 100\n\n// ===============================\n\ndef currentOffset =\n    (flowFile.getAttribute('nyc311_offset') ?: '0') as Integer\n\ndef statusFilter =\n    flowFile.getAttribute('nyc311_status_filter')\n\n// Read the current page\ndef currentText = null\ndef currentRows = null\n\nflowFile = session.write(flowFile, { inputStream, outputStream ->\n\n    currentText = IOUtils.toString(\n        inputStream,\n        StandardCharsets.UTF_8\n    )\n\n    currentRows = new JsonSlurper().parseText(currentText)\n\n    // Keep the current page unchanged\n    outputStream.write(\n        currentText.getBytes(StandardCharsets.UTF_8)\n    )\n\n} as StreamCallback)\n\n// How many records have we received so far?\ndef recordsReceived = currentOffset + currentRows.size()\n\nlog.info(\n    \"NYC311 pagination: offset=${currentOffset}, \" +\n    \"pageSize=${currentRows.size()}, \" +\n    \"totalReceived=${recordsReceived}, \" +\n    \"target=${TOTAL_RECORDS}\"\n)\n\n// ========================================\n// STOP CONDITIONS\n// ========================================\n\n// We have reached the requested number\nif (recordsReceived >= TOTAL_RECORDS) {\n\n    log.info(\n        \"NYC311 target reached: ${recordsReceived} records\"\n    )\n\n    flowFile = session.putAttribute(\n        flowFile,\n        'nyc311_finished',\n        'true'\n    )\n\n    // FIXED: was REL_SUCCESS — caused infinite duplicate re-forwarding\n    session.transfer(flowFile, REL_FAILURE)\n    return\n}\n\n// The API returned fewer records than requested.\n// This means there are no more records.\nif (currentRows.size() < PAGE_SIZE) {\n\n    log.info(\n        \"NYC311 API returned fewer than PAGE_SIZE. \" +\n        \"Pagination finished at ${recordsReceived} records.\"\n    )\n\n    flowFile = session.putAttribute(\n        flowFile,\n        'nyc311_finished',\n        'true'\n    )\n\n    // FIXED: was REL_SUCCESS — caused infinite duplicate re-forwarding\n    session.transfer(flowFile, REL_FAILURE)\n    return\n}\n\n// ========================================\n// GET NEXT PAGE\n// ========================================\n\ndef nextOffset = currentOffset + currentRows.size()\n\n// Don't request more than TOTAL_RECORDS\ndef remaining = TOTAL_RECORDS - nextOffset\n\ndef nextPageSize = Math.min(\n    PAGE_SIZE,\n    remaining\n)\n\ndef urlStr =\n    \"https://data.cityofnewyork.us/resource/erm2-nwe9.json\" +\n    \"?\\$limit=${nextPageSize}\" +\n    \"&\\$offset=${nextOffset}\"\n\n// Keep the Closed filter if it exists\nif (statusFilter) {\n\n    def encodedFilter =\n        java.net.URLEncoder.encode(\n            \"status='${statusFilter}'\",\n            \"UTF-8\"\n        )\n\n    urlStr += \"&\\$where=${encodedFilter}\"\n}\n\n// Sort newest first\ndef encodedOrder =\n    java.net.URLEncoder.encode(\n        \"created_date DESC\",\n        \"UTF-8\"\n    )\n\nurlStr += \"&\\$order=${encodedOrder}\"\n\nlog.info(\n    \"Requesting next NYC311 page: ${urlStr}\"\n)\n\n// ========================================\n// REQUEST NEXT PAGE\n// ========================================\n\ntry {\n\n    def connection =\n        new URL(urlStr).openConnection()\n\n    connection.setRequestProperty(\n        \"Accept\",\n        \"application/json\"\n    )\n\n    def responseCode =\n        connection.getResponseCode()\n\n    if (responseCode != 200) {\n\n        throw new Exception(\n            \"NYC API returned HTTP ${responseCode}\"\n        )\n    }\n\n    def nextReply =\n        connection.getInputStream().getText(\"UTF-8\")\n\n    // Replace current page with next page\n    flowFile = session.write(\n        flowFile,\n        { outputStream ->\n            outputStream.write(\n                nextReply.getBytes(\n                    StandardCharsets.UTF_8\n                )\n            )\n        } as org.apache.nifi.processor.io.OutputStreamCallback\n    )\n\n    // Save offset for next execution\n    flowFile = session.putAttribute(\n        flowFile,\n        'nyc311_offset',\n        nextOffset.toString()\n    )\n\n    flowFile = session.putAttribute(\n        flowFile,\n        'nyc311_page_size',\n        nextPageSize.toString()\n    )\n\n    flowFile = session.putAttribute(\n        flowFile,\n        'nyc311_total_records',\n        TOTAL_RECORDS.toString()\n    )\n\n    session.transfer(flowFile, REL_SUCCESS)\n\n} catch (Exception e) {\n\n    log.error(\n        \"Failed to retrieve NYC311 page\",\n        e\n    )\n\n    session.transfer(flowFile, REL_FAILURE)\n}"
          },
