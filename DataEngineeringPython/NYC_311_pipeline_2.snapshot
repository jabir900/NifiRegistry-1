        }, {
          "autoTerminatedRelationships" : [ "failure" ],
          "bulletinLevel" : "WARN",
          "bundle" : {
            "artifact" : "nifi-scripting-nar",
            "group" : "org.apache.nifi",
            "version" : "2.9.0"
          },
          "comments" : "",
          "componentType" : "PROCESSOR",
          "concurrentlySchedulableTaskCount" : 1,
          "executionNode" : "ALL",
          "groupIdentifier" : "3c2703bb-d69d-3d84-bfa5-011a09caf010",
          "identifier" : "637f503f-3dbd-36ec-b127-9a858ff321ea",
          "name" : "Query NYC311 - Closed",
          "penaltyDuration" : "30 sec",
          "position" : {
            "x" : 6221.88916015625,
            "y" : -2043.7777709960938
          },
          "properties" : {
            "Script Engine" : "Groovy",
            "Script Body" : "import java.nio.charset.StandardCharsets\nimport org.apache.nifi.processor.io.OutputStreamCallback\n\ndef flowFile = session.get()\nif (!flowFile) return\n\ndef PAGE_SIZE = 100\n\ndef urlStr =\n    \"https://data.cityofnewyork.us/resource/erm2-nwe9.json\" +\n    \"?\\$limit=${PAGE_SIZE}\" +\n    \"&\\$offset=0\" +\n    \"&\\$where=status%3D%27Closed%27\" +\n    \"&\\$order=created_date%20DESC\"\n\nlog.info(\"NYC311 Closed URL: ${urlStr}\")\n\nflowFile = session.write(flowFile, { outputStream ->\n\n    def connection = new URL(urlStr).openConnection()\n\n    connection.setRequestProperty(\n        \"Accept\",\n        \"application/json\"\n    )\n\n    def responseCode = connection.getResponseCode()\n\n    log.info(\"NYC311 HTTP response: ${responseCode}\")\n\n    if (responseCode != 200) {\n        throw new Exception(\n            \"NYC311 returned HTTP ${responseCode}\"\n        )\n    }\n\n    def rawreply =\n        connection.getInputStream().getText(\"UTF-8\")\n\n    log.info(\n        \"NYC311 Closed response length: ${rawreply.length()}\"\n    )\n\n    outputStream.write(\n        rawreply.getBytes(StandardCharsets.UTF_8)\n    )\n\n} as OutputStreamCallback)\n\nflowFile = session.putAttribute(\n    flowFile,\n    'nyc311_offset',\n    '0'\n)\n\nflowFile = session.putAttribute(\n    flowFile,\n    'nyc311_page_size',\n    PAGE_SIZE.toString()\n)\n\nflowFile = session.putAttribute(\n    flowFile,\n    'nyc311_status_filter',\n    'Closed'\n)\n\nsession.transfer(flowFile, REL_SUCCESS)"
          },
          "propertyDescriptors" : {
            "Script File" : {
              "displayName" : "Script File",
              "identifiesControllerService" : false,
              "name" : "Script File",
              "sensitive" : false
            },
            "Script Engine" : {
